<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Privacy Control – HealthSync</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono&display=swap" rel="stylesheet"/>
  <style>
    *{font-family:'DM Sans',sans-serif}
    code,pre{font-family:'DM Mono',monospace}
    .gradient-bg{background:linear-gradient(135deg,#f0fdfa 0%,#e0f2fe 50%,#f0fdf4 100%)}
    .card-hover{transition:all .3s cubic-bezier(.4,0,.2,1)}
    .card-hover:hover{transform:translateY(-4px);box-shadow:0 20px 40px -12px rgba(20,184,166,.15)}
    .badge-read{background:#dbeafe;color:#1d4ed8}
    .badge-write{background:#dcfce7;color:#166534}
    .badge-admin{background:#fee2e2;color:#991b1b}
    .progress-track{background:#e2e8f0;border-radius:999px;overflow:hidden}
    .progress-bar{height:8px;border-radius:999px;background:linear-gradient(90deg,#14b8a6,#0ea5e9);transition:width 1s ease}
    .timeline-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:4px}
    .fade-in{animation:fadeIn .5s ease forwards;opacity:0}
    @keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
    .stagger-1{animation-delay:.1s}.stagger-2{animation-delay:.2s}.stagger-3{animation-delay:.3s}.stagger-4{animation-delay:.4s}.stagger-5{animation-delay:.5s}
  </style>
</head>
<body class="min-h-screen bg-slate-50">

  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/dashboard" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center shadow-md">
          <i class="fa-solid fa-heart-pulse text-white text-sm"></i>
        </div>
        <span class="font-bold text-slate-800 text-lg tracking-tight">HealthSync</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="/dashboard" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-gauge-high"></i><span class="hidden sm:inline">Dashboard</span>
        </a>
        <a href="/history" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-timeline"></i><span class="hidden sm:inline">History</span>
        </a>
        <a href="/analytics" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-chart-bar"></i><span class="hidden sm:inline">Analytics</span>
        </a>
        <a href="/privacy" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-shield-halved"></i><span class="hidden sm:inline">Privacy</span>
        </a>
        <a href="/logout" class="ml-3 px-4 py-2 rounded-xl text-sm font-medium bg-red-50 text-red-600 hover:bg-red-100 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-right-from-bracket"></i><span class="hidden sm:inline">Logout</span>
        </a>
      </div>
    </div>
  </nav>

<div class="pt-20 pb-12 px-4 sm:px-6 max-w-6xl mx-auto">

  <div class="mb-8 fade-in">
    <h1 class="text-3xl font-bold text-slate-800">Privacy & Data Access</h1>
    <p class="text-slate-500 text-sm mt-1">Manage who can access your health data and revoke permissions anytime.</p>
  </div>

  <!-- Info Banner -->
  <div class="bg-teal-50 border border-teal-200 rounded-2xl p-4 flex items-start gap-4 mb-6 fade-in stagger-1">
    <div class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center flex-shrink-0">
      <i class="fa-solid fa-shield-halved text-teal-600"></i>
    </div>
    <div>
      <p class="font-semibold text-teal-800 text-sm">Your data, your control</p>
      <p class="text-xs text-teal-600 mt-0.5">All access grants are encrypted and can be revoked instantly. Expired grants are highlighted automatically.</p>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl shadow-md border border-slate-100 overflow-hidden fade-in stagger-2">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
      <h3 class="font-semibold text-slate-800 flex items-center gap-2">
        <i class="fa-solid fa-key text-teal-500"></i>
        Active Access Grants
      </h3>
      <span class="text-xs bg-slate-100 text-slate-600 px-3 py-1 rounded-full font-medium">
        <%= accessRecords.length %> total
      </span>
    </div>

    <% if (accessRecords.length === 0) { %>
      <div class="text-center py-16 text-slate-400">
        <i class="fa-solid fa-lock text-5xl mb-4 block text-slate-200"></i>
        <p class="font-medium text-slate-500">No data access grants found.</p>
        <p class="text-sm mt-1">Your health data is completely private.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50">
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Shared With</th>
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Permission</th>
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Expiry Date</th>
              <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
              <th class="text-right px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <% accessRecords.forEach(function(rec, i){ %>
              <% const isExpired = new Date(rec.expiry_date) < new Date(); %>
              <tr class="hover:bg-slate-50 transition-colors duration-150 <%= isExpired ? 'opacity-60' : '' %>">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-teal-400 to-cyan-500 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                      <%= rec.shared_with ? rec.shared_with.charAt(0).toUpperCase() : '?' %>
                    </div>
                    <span class="font-medium text-slate-700"><%= rec.shared_with %></span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <% let badgeClass = 'badge-read'; %>
                  <% if (rec.permission_level && rec.permission_level.toLowerCase() === 'write') badgeClass = 'badge-write'; %>
                  <% if (rec.permission_level && rec.permission_level.toLowerCase() === 'admin') badgeClass = 'badge-admin'; %>
                  <span class="<%= badgeClass %> text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wide">
                    <% if (rec.permission_level && rec.permission_level.toLowerCase() === 'write') { %>
                      <i class="fa-solid fa-pen-to-square mr-1"></i>
                    <% } else if (rec.permission_level && rec.permission_level.toLowerCase() === 'admin') { %>
                      <i class="fa-solid fa-crown mr-1"></i>
                    <% } else { %>
                      <i class="fa-solid fa-eye mr-1"></i>
                    <% } %>
                    <%= rec.permission_level || 'read' %>
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-600">
                  <i class="fa-solid fa-calendar-days mr-1.5 text-slate-400"></i>
                  <%= new Date(rec.expiry_date).toLocaleDateString('en-IN',{year:'numeric',month:'short',day:'numeric'}) %>
                </td>
                <td class="px-6 py-4">
                  <% if (isExpired) { %>
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-red-600 bg-red-50 px-2.5 py-1 rounded-full">
                      <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>Expired
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 bg-green-50 px-2.5 py-1 rounded-full">
                      <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>Active
                    </span>
                  <% } %>
                </td>
                <td class="px-6 py-4 text-right">
                  <form method="POST" action="/privacy/revoke" onsubmit="return confirm('Revoke access for <%= rec.shared_with %>?')">
                    <input type="hidden" name="access_id" value="<%= rec.access_id %>"/>
                    <button type="submit"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 px-3 py-1.5 rounded-xl transition-all duration-200 hover:shadow-sm">
                      <i class="fa-solid fa-ban"></i>
                      Revoke
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Footer info -->
  <p class="text-center text-xs text-slate-400 mt-6 fade-in stagger-3">
    <i class="fa-solid fa-circle-info mr-1"></i>
    Revoking access immediately removes the grant from the database. This action cannot be undone.
  </p>
</div>
</body>
</html>