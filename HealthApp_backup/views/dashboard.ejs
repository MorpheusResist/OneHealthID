<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard – HealthSync</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono&display=swap" rel="stylesheet"/>
  <style>
    *{font-family:'DM Sans',sans-serif}
    code,pre{font-family:'DM Mono',monospace}
    .gradient-bg{background:linear-gradient(135deg,#f0fdfa 0%,#e0f2fe 50%,#f0fdf4 100%)}
    .card-hover{transition:all .3s cubic-bezier(.4,0,.2,1)}
    .card-hover:hover{transform:translateY(-4px);box-shadow:0 20px 40px -12px rgba(20,184,166,.15)}
    .badge-read{background:#dbeafe;color:#1d4ed8}
    .badge-write{background:#dcfce7;color:#166534}
    .badge-admin{background:#fee2e2;color:#991b1b}
    .progress-track{background:#e2e8f0;border-radius:999px;overflow:hidden}
    .progress-bar{height:8px;border-radius:999px;background:linear-gradient(90deg,#14b8a6,#0ea5e9);transition:width 1s ease}
    .timeline-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:4px}
    .fade-in{animation:fadeIn .5s ease forwards;opacity:0}
    @keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
    .stagger-1{animation-delay:.1s}.stagger-2{animation-delay:.2s}.stagger-3{animation-delay:.3s}.stagger-4{animation-delay:.4s}.stagger-5{animation-delay:.5s}
  </style>
</head>
<body class="min-h-screen bg-slate-50">

  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/dashboard" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center shadow-md">
          <i class="fa-solid fa-heart-pulse text-white text-sm"></i>
        </div>
        <span class="font-bold text-slate-800 text-lg tracking-tight">HealthSync</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="/dashboard" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-gauge-high"></i><span class="hidden sm:inline">Dashboard</span>
        </a>
        <a href="/history" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-timeline"></i><span class="hidden sm:inline">History</span>
        </a>
        <a href="/analytics" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-chart-bar"></i><span class="hidden sm:inline">Analytics</span>
        </a>
        <a href="/privacy" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-shield-halved"></i><span class="hidden sm:inline">Privacy</span>
        </a>
        <a href="/logout" class="ml-3 px-4 py-2 rounded-xl text-sm font-medium bg-red-50 text-red-600 hover:bg-red-100 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-right-from-bracket"></i><span class="hidden sm:inline">Logout</span>
        </a>
      </div>
    </div>
  </nav>

<div class="pt-20 pb-12 px-4 sm:px-6 max-w-7xl mx-auto">

  <!-- Header -->
  <div class="mb-8 fade-in">
    <p class="text-teal-600 font-medium text-sm mb-1">
      <i class="fa-solid fa-sun mr-1"></i>
      <%= (new Date().getHours() < 12) ? 'Good morning' : (new Date().getHours() < 17) ? 'Good afternoon' : 'Good evening' %>
    </p>
    <h1 class="text-3xl font-bold text-slate-800">
      <%= user.name %> <span class="wave">👋</span>
    </h1>
    <p class="text-slate-500 mt-1 text-sm">Here's your unified health overview for today.</p>
  </div>

  <!-- User Profile Card -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-2xl shadow-md border border-slate-100 p-6 card-hover fade-in stagger-1">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-teal-400 to-cyan-500 flex items-center justify-center shadow-lg flex-shrink-0">
          <i class="fa-solid fa-user text-white text-xl"></i>
        </div>
        <div>
          <h3 class="font-semibold text-slate-800 text-base"><%= user.name %></h3>
          <p class="text-slate-500 text-xs"><%= user.email %></p>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 pt-3 border-t border-slate-100">
        <div class="text-center">
          <p class="text-lg font-bold text-slate-800"><%= user.age %></p>
          <p class="text-xs text-slate-400">Age</p>
        </div>
        <div class="text-center border-x border-slate-100">
          <p class="text-lg font-bold text-slate-800"><%= user.gender ? user.gender.charAt(0) : 'N/A' %></p>
          <p class="text-xs text-slate-400">Gender</p>
        </div>
        <div class="text-center">
          <p class="text-lg font-bold text-teal-600"><%= user.blood_group || 'N/A' %></p>
          <p class="text-xs text-slate-400">Blood</p>
        </div>
      </div>
    </div>

    <!-- Wearable Data Card -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-md border border-slate-100 p-6 card-hover fade-in stagger-2">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold text-slate-800 flex items-center gap-2">
          <i class="fa-solid fa-watch text-teal-500"></i>
          Latest Wearable Data
        </h3>
        <% if (wearable) { %>
          <span class="text-xs bg-teal-50 text-teal-600 px-3 py-1 rounded-full font-medium">
            <i class="fa-solid fa-calendar-check mr-1"></i>
            <%= new Date(wearable.record_date).toLocaleDateString('en-IN', {month:'short',day:'numeric',year:'numeric'}) %>
          </span>
        <% } %>
      </div>

      <% if (wearable) { %>
        <div class="grid grid-cols-3 gap-4 mb-5">
          <div class="bg-slate-50 rounded-xl p-4 text-center">
            <i class="fa-solid fa-person-walking text-cyan-500 text-xl mb-2"></i>
            <p class="text-2xl font-bold text-slate-800"><%= wearable.steps.toLocaleString() %></p>
            <p class="text-xs text-slate-400 mt-0.5">Steps</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 text-center">
            <i class="fa-solid fa-moon text-indigo-400 text-xl mb-2"></i>
            <p class="text-2xl font-bold text-slate-800"><%= wearable.sleep_hours %><span class="text-sm text-slate-400">h</span></p>
            <p class="text-xs text-slate-400 mt-0.5">Sleep</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 text-center">
            <i class="fa-solid fa-heart-pulse text-red-400 text-xl mb-2"></i>
            <p class="text-2xl font-bold text-slate-800"><%= wearable.heart_rate %><span class="text-sm text-slate-400">bpm</span></p>
            <p class="text-xs text-slate-400 mt-0.5">Heart Rate</p>
          </div>
        </div>
        <!-- Steps progress bar (goal: 10000) -->
        <div>
          <div class="flex justify-between text-xs text-slate-500 mb-1.5">
            <span>Daily Step Goal</span>
            <span><%= Math.min(Math.round(wearable.steps/10000*100),100) %>% of 10,000</span>
          </div>
          <div class="progress-track h-2">
            <div class="progress-bar" style="width:<%= Math.min(Math.round(wearable.steps/10000*100),100) %>%"></div>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-8 text-slate-400">
          <i class="fa-solid fa-watch text-3xl mb-3 block text-slate-200"></i>
          No wearable data recorded yet.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Active Medications -->
  <div class="bg-white rounded-2xl shadow-md border border-slate-100 p-6 card-hover fade-in stagger-3">
    <div class="flex items-center justify-between mb-5">
      <h3 class="font-semibold text-slate-800 flex items-center gap-2">
        <i class="fa-solid fa-pills text-teal-500"></i>
        Active Medications
      </h3>
      <span class="text-xs bg-green-50 text-green-600 px-3 py-1 rounded-full font-medium">
        <%= medications.length %> Active
      </span>
    </div>

    <% if (medications.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% medications.forEach(function(med, i){ %>
          <div class="bg-gradient-to-br from-teal-50 to-cyan-50 border border-teal-100 rounded-xl p-4">
            <div class="flex items-start justify-between mb-2">
              <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-capsules text-teal-600 text-xs"></i>
              </div>
              <span class="text-xs text-teal-700 bg-teal-100 px-2 py-0.5 rounded-full font-medium"><%= med.dosage %></span>
            </div>
            <p class="font-semibold text-slate-800 text-sm mt-2"><%= med.medication_name %></p>
            <p class="text-xs text-slate-500 mt-1">
              <i class="fa-solid fa-calendar-xmark mr-1 text-red-400"></i>
              Until <%= new Date(med.end_date).toLocaleDateString('en-IN',{month:'short',day:'numeric',year:'numeric'}) %>
            </p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-8 text-slate-400">
        <i class="fa-solid fa-pills text-3xl mb-3 block text-slate-200"></i>
        No active medications found.
      </div>
    <% } %>
  </div>

  <!-- Quick Nav Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6 fade-in stagger-4">
    <a href="/history" class="bg-white rounded-2xl shadow-md border border-slate-100 p-5 card-hover flex flex-col items-center text-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-purple-50 flex items-center justify-center">
        <i class="fa-solid fa-timeline text-purple-500 text-lg"></i>
      </div>
      <div><p class="font-semibold text-slate-800 text-sm">Medical History</p><p class="text-xs text-slate-400 mt-0.5">Clinic & Lab records</p></div>
    </a>
    <a href="/analytics" class="bg-white rounded-2xl shadow-md border border-slate-100 p-5 card-hover flex flex-col items-center text-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center">
        <i class="fa-solid fa-chart-bar text-orange-500 text-lg"></i>
      </div>
      <div><p class="font-semibold text-slate-800 text-sm">Analytics</p><p class="text-xs text-slate-400 mt-0.5">Workouts & trends</p></div>
    </a>
    <a href="/privacy" class="bg-white rounded-2xl shadow-md border border-slate-100 p-5 card-hover flex flex-col items-center text-center gap-3 col-span-2 sm:col-span-1">
      <div class="w-12 h-12 rounded-xl bg-teal-50 flex items-center justify-center">
        <i class="fa-solid fa-shield-halved text-teal-500 text-lg"></i>
      </div>
      <div><p class="font-semibold text-slate-800 text-sm">Privacy Control</p><p class="text-xs text-slate-400 mt-0.5">Manage data access</p></div>
    </a>
  </div>
</div>
</body>
</html>