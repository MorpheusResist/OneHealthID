<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Analytics – HealthSync</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono&display=swap" rel="stylesheet"/>
  <style>
    *{font-family:'DM Sans',sans-serif}
    code,pre{font-family:'DM Mono',monospace}
    .gradient-bg{background:linear-gradient(135deg,#f0fdfa 0%,#e0f2fe 50%,#f0fdf4 100%)}
    .card-hover{transition:all .3s cubic-bezier(.4,0,.2,1)}
    .card-hover:hover{transform:translateY(-4px);box-shadow:0 20px 40px -12px rgba(20,184,166,.15)}
    .badge-read{background:#dbeafe;color:#1d4ed8}
    .badge-write{background:#dcfce7;color:#166534}
    .badge-admin{background:#fee2e2;color:#991b1b}
    .progress-track{background:#e2e8f0;border-radius:999px;overflow:hidden}
    .progress-bar{height:8px;border-radius:999px;background:linear-gradient(90deg,#14b8a6,#0ea5e9);transition:width 1s ease}
    .timeline-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:4px}
    .fade-in{animation:fadeIn .5s ease forwards;opacity:0}
    @keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
    .stagger-1{animation-delay:.1s}.stagger-2{animation-delay:.2s}.stagger-3{animation-delay:.3s}.stagger-4{animation-delay:.4s}.stagger-5{animation-delay:.5s}
  </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<body class="min-h-screen bg-slate-50">

  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
      <a href="/dashboard" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center shadow-md">
          <i class="fa-solid fa-heart-pulse text-white text-sm"></i>
        </div>
        <span class="font-bold text-slate-800 text-lg tracking-tight">HealthSync</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="/dashboard" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-gauge-high"></i><span class="hidden sm:inline">Dashboard</span>
        </a>
        <a href="/history" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-timeline"></i><span class="hidden sm:inline">History</span>
        </a>
        <a href="/analytics" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-chart-bar"></i><span class="hidden sm:inline">Analytics</span>
        </a>
        <a href="/privacy" class="nav-link px-4 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-shield-halved"></i><span class="hidden sm:inline">Privacy</span>
        </a>
        <a href="/logout" class="ml-3 px-4 py-2 rounded-xl text-sm font-medium bg-red-50 text-red-600 hover:bg-red-100 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-right-from-bracket"></i><span class="hidden sm:inline">Logout</span>
        </a>
      </div>
    </div>
  </nav>

<div class="pt-20 pb-12 px-4 sm:px-6 max-w-7xl mx-auto">

  <div class="mb-8 fade-in">
    <h1 class="text-3xl font-bold text-slate-800">Health Analytics</h1>
    <p class="text-slate-500 text-sm mt-1">Aggregated insights from your workouts and wearable data.</p>
  </div>

  <!-- Stat Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <% const stats = [
      { icon:'fa-fire-flame-curved', color:'orange', label:'Calories Burned', value: workoutStats.total_calories ? Math.round(workoutStats.total_calories).toLocaleString() : '0', unit:'kcal' },
      { icon:'fa-clock', color:'teal', label:'Total Workout Time', value: workoutStats.total_minutes ? Math.round(workoutStats.total_minutes).toLocaleString() : '0', unit:'min' },
      { icon:'fa-dumbbell', color:'purple', label:'Sessions Logged', value: workoutStats.total_sessions || '0', unit:'sessions' },
      { icon:'fa-stopwatch', color:'cyan', label:'Avg. Duration', value: workoutStats.avg_duration ? parseFloat(workoutStats.avg_duration).toFixed(1) : '0', unit:'min/session' }
    ]; %>
    <% stats.forEach(function(s, i){ %>
      <div class="bg-white rounded-2xl shadow-md border border-slate-100 p-5 card-hover fade-in stagger-<%= i+1 %>">
        <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-<%= s.color %>-50 flex items-center justify-center">
            <i class="fa-solid <%= s.icon %> text-<%= s.color %>-500"></i>
          </div>
        </div>
        <p class="text-2xl font-bold text-slate-800"><%= s.value %></p>
        <p class="text-xs text-slate-400 mt-0.5"><%= s.unit %></p>
        <p class="text-sm text-slate-600 mt-2 font-medium"><%= s.label %></p>
      </div>
    <% }) %>
  </div>

  <!-- Wearable Averages + Chart -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Wearable Averages -->
    <div class="bg-white rounded-2xl shadow-md border border-slate-100 p-6 card-hover fade-in stagger-3">
      <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
        <i class="fa-solid fa-watch text-teal-500"></i>
        Wearable Averages
      </h3>
      <div class="space-y-4">
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-person-walking text-cyan-500 w-5 text-center"></i>
            <span class="text-sm text-slate-600">Avg Steps/day</span>
          </div>
          <span class="font-bold text-slate-800">
            <%= wearableAvg.avg_steps ? Math.round(wearableAvg.avg_steps).toLocaleString() : 'N/A' %>
          </span>
        </div>
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-moon text-indigo-400 w-5 text-center"></i>
            <span class="text-sm text-slate-600">Avg Sleep</span>
          </div>
          <span class="font-bold text-slate-800">
            <%= wearableAvg.avg_sleep ? parseFloat(wearableAvg.avg_sleep).toFixed(1) : 'N/A' %> hrs
          </span>
        </div>
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-heart-pulse text-red-400 w-5 text-center"></i>
            <span class="text-sm text-slate-600">Avg Heart Rate</span>
          </div>
          <span class="font-bold text-slate-800">
            <%= wearableAvg.avg_hr ? parseFloat(wearableAvg.avg_hr).toFixed(0) : 'N/A' %> bpm
          </span>
        </div>
      </div>
    </div>

    <!-- Chart -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-md border border-slate-100 p-6 card-hover fade-in stagger-4">
      <h3 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
        <i class="fa-solid fa-chart-bar text-teal-500"></i>
        Workout Duration by Type
      </h3>
      <% if (workoutByType.length > 0) { %>
        <div class="relative h-64">
          <canvas id="workoutChart"></canvas>
        </div>
        <script>
          const ctx = document.getElementById('workoutChart').getContext('2d');
          new Chart(ctx, {
            type: 'bar',
            data: {
              labels: <%- JSON.stringify(workoutByType.map(w => w.workout_type)) %>,
              datasets: [{
                label: 'Total Minutes',
                data: <%- JSON.stringify(workoutByType.map(w => w.total_duration)) %>,
                backgroundColor: workoutByType.map((_, i) => {
                  const colors = ['rgba(20,184,166,0.8)','rgba(14,165,233,0.8)','rgba(99,102,241,0.8)','rgba(249,115,22,0.8)','rgba(236,72,153,0.8)'];
                  return colors[i % colors.length];
                }),
                borderRadius: 10,
                borderSkipped: false,
              }]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                x: { grid: { display: false }, ticks: { font: { family: 'DM Sans', size: 12 } } },
                y: { grid: { color: '#f1f5f9' }, ticks: { font: { family: 'DM Sans', size: 12 } } }
              }
            }
          });
          const workoutByType = <%- JSON.stringify(workoutByType) %>;
        </script>
      <% } else { %>
        <div class="h-64 flex flex-col items-center justify-center text-slate-300">
          <i class="fa-solid fa-chart-bar text-5xl mb-3"></i>
          <p class="text-sm text-slate-400">No workout data to display.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>